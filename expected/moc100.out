CREATE TABLE moc100 (
	ivoid text,
	coverage smoc,
	ref_system_name text
);
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column named 'ivoid' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
COPY moc100 FROM STDIN;
ANALYZE moc100;
CREATE INDEX ON moc100 USING GIN (coverage);
SELECT ivoid FROM moc100 WHERE coverage && '4/0' ORDER BY ivoid;
