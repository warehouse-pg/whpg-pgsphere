-- both sides indexable, check if the planner figures out the better choice
select explain('select * from spoint10k a join spoint10k b on spoint_dwithin(a.star, b.star, .01)
  where spoint_dwithin(a.star, spoint(1,1), .1) and spoint_dwithin(b.star, spoint(1,1), .05)');
                                                                  explain                                                                  
-------------------------------------------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)  (rows=5 width=32) (actual rows=16.00 loops=1)
   ->  Nested Loop  (rows=2 width=32) (actual rows=7.00 loops=1)
         Disabled: true
         ->  Broadcast Motion 3:3  (slice2; segments: 3)  (rows=6 width=16) (actual rows=12.00 loops=1)
               ->  Bitmap Heap Scan on spoint10k b  (rows=2 width=16) (actual rows=5.00 loops=1)
                     Filter: spoint_dwithin(star, '(1 , 1)'::spoint, '0.05'::double precision)
                     Rows Removed by Filter: 4
                     Heap Blocks: exact=4
                     ->  Bitmap Index Scan on spoint10k_star_idx  (rows=2 width=0) (actual rows=9.00 loops=1)
                           Index Cond: (star <@ '<(1 , 1) , 0.05>'::scircle)
         ->  Index Scan using spoint10k_star_idx on spoint10k a  (rows=1 width=16) (actual rows=0.58 loops=12)
               Index Cond: ((star OPERATOR(public.<@) scircle(b.star, '0.01'::double precision)) AND (star <@ '<(1 , 1) , 0.1>'::scircle))
               Rows Removed by Index Recheck: 0
 Optimizer: Postgres-based planner
(14 rows)

