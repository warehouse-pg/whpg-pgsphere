-- spoint_dwithin function selectivity
set jit = off; -- suppress extra planning output
select explain('select * from spoint10k where spoint_dwithin(star, spoint(1,1), 1)');
                                           explain                                            
----------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)  (rows=2298 width=16) (actual rows=3009.00 loops=1)
   ->  Seq Scan on spoint10k  (rows=766 width=16) (actual rows=1013.00 loops=1)
         Filter: spoint_dwithin(star, '(1 , 1)'::spoint, '1'::double precision)
         Rows Removed by Filter: 2276
 Optimizer: Postgres-based planner
(5 rows)

select explain('select * from spoint10k where spoint_dwithin(star, spoint(1,1), .1)');
                                              explain                                              
---------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)  (rows=25 width=16) (actual rows=29.00 loops=1)
   ->  Bitmap Heap Scan on spoint10k  (rows=8 width=16) (actual rows=13.00 loops=1)
         Filter: spoint_dwithin(star, '(1 , 1)'::spoint, '0.1'::double precision)
         Rows Removed by Filter: 8
         Heap Blocks: exact=5
         ->  Bitmap Index Scan on spoint10k_star_idx  (rows=8 width=0) (actual rows=21.00 loops=1)
               Index Cond: (star <@ '<(1 , 1) , 0.1>'::scircle)
 Optimizer: Postgres-based planner
(8 rows)

